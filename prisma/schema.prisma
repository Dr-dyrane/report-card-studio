generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  DRAFT
  PUBLISHED
  LOCKED
}

enum AssessmentMode {
  CONTINUOUS_AND_EXAM
  EXAM_ONLY
}

enum AssessmentEntryMode {
  PER_SUBJECT
  AGGREGATE_TOTALS
}

enum StudentExportPreference {
  PDF
  PREVIEW
}

enum ClassExportPreference {
  EXCEL
  CSV
}

enum ScanKind {
  REPORT_CARD
  GRAND_SHEET
}

enum ScanStatus {
  CREATED
  UPLOADING
  STORED
  PROCESSING
  READY
  NEEDS_REVIEW
  FAILED
}

enum ScanAttemptStatus {
  CREATED
  PROCESSING
  READY
  NEEDS_REVIEW
  FAILED
}

model School {
  id                     String                  @id @default(cuid())
  name                   String
  ownerId                String?
  preferredStudentExport StudentExportPreference @default(PDF)
  preferredClassExport   ClassExportPreference   @default(EXCEL)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  owner                  User?                   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  sessions               AcademicSession[]
  classrooms             Classroom[]
  students               Student[]
  subjects               Subject[]
  scanSources            ScanSource[]

  @@index([ownerId])
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(false)
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms     Term[]

  @@map("Session")
}

model Term {
  id             String          @id @default(cuid())
  name           String
  sequence       Int
  isActive       Boolean         @default(false)
  sessionId      String
  nextTermBegins String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reportCards    ReportCard[]
  scanSources    ScanSource[]

  @@unique([sessionId, sequence])
}

model Classroom {
  id            String         @id @default(cuid())
  name          String
  level         String?
  teacherName   String?
  displayOrder  Int            @default(0)
  schoolId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students      Student[]
  classSubjects ClassSubject[]
  reportCards   ReportCard[]
  scanSources   ScanSource[]
}

model Student {
  id              String       @id @default(cuid())
  fullName        String
  admissionNumber String?
  gender          String?
  isActive        Boolean      @default(true)
  schoolId        String
  classroomId     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom       Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  reportCards     ReportCard[]

  @@unique([classroomId, fullName])
}

model Subject {
  id             String         @id @default(cuid())
  name           String
  category       String?
  assessmentMode AssessmentMode
  a1Max          Int?
  a2Max          Int?
  examMax        Int?
  displayOrder   Int            @default(0)
  isActive       Boolean        @default(true)
  schoolId       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects  ClassSubject[]
  reportScores   ReportScore[]

  @@unique([schoolId, name])
}

model ClassSubject {
  id           String    @id @default(cuid())
  classroomId  String
  subjectId    String
  displayOrder Int       @default(0)
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classroomId, subjectId])
}

model ReportCard {
  id                  String              @id @default(cuid())
  studentId           String
  classroomId         String
  termId              String
  status              ReportStatus        @default(DRAFT)
  assessmentEntryMode AssessmentEntryMode @default(PER_SUBJECT)
  position            String?
  classSize           Int?
  grandTotal          Int                 @default(0)
  grandMax            Int                 @default(1000)
  assessment1Total    Int                 @default(0)
  assessment2Total    Int                 @default(0)
  examTotal           Int                 @default(0)
  teacherComment      String?
  headTeacherComment  String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  student             Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom           Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  term                Term                @relation(fields: [termId], references: [id], onDelete: Cascade)
  scores              ReportScore[]
  scanSources         ScanSource[]

  @@unique([studentId, termId])
}

model ReportScore {
  id           String     @id @default(cuid())
  reportCardId String
  subjectId    String
  a1Score      Int?
  a2Score      Int?
  examScore    Int?
  totalScore   Int        @default(0)
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([reportCardId, subjectId])
}

model ScanSource {
  id                  String        @id @default(cuid())
  kind                ScanKind
  status              ScanStatus    @default(CREATED)
  schoolId            String
  creatorId           String
  classroomId         String?
  termId              String?
  reportCardId        String?
  blobPathname        String?       @unique
  originalFilename    String?
  contentType         String?
  byteSize            Int?
  width               Int?
  height              Int?
  safeError           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  storedAt            DateTime?
  processingStartedAt DateTime?
  completedAt         DateTime?
  school              School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creator             User          @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  classroom           Classroom?    @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  term                Term?         @relation(fields: [termId], references: [id], onDelete: SetNull)
  reportCard          ReportCard?   @relation(fields: [reportCardId], references: [id], onDelete: SetNull)
  attempts            ScanAttempt[]

  @@index([schoolId, status])
  @@index([creatorId])
  @@index([classroomId])
  @@index([termId])
  @@index([reportCardId])
}

model ScanAttempt {
  id               String            @id @default(cuid())
  scanSourceId     String
  attemptNumber    Int
  status           ScanAttemptStatus @default(CREATED)
  model            String?
  promptVersion    String
  structuredResult Json?
  warnings         Json?
  safeError        String?
  createdAt        DateTime          @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  scanSource       ScanSource        @relation(fields: [scanSourceId], references: [id], onDelete: Cascade)

  @@unique([scanSourceId, attemptNumber])
  @@index([scanSourceId, status])
}

model User {
  id              String       @id
  name            String
  email           String
  emailVerified   Boolean      @default(false)
  image           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  username        String?
  displayUsername String?
  schools         School[]
  scanSources     ScanSource[]
  sessions        Session[]
  accounts        Account[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
